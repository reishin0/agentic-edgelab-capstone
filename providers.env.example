# Copy to providers.env for EdgeLab's private provider configuration.
# Use the loopback server URL and exact loaded instance ID shown in LM Studio.
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_PLANNER_MODEL=ornith-1.5-35b-a3b-q4-k-m
LM_STUDIO_PLANNER_PROFILE=ornith

# Change to 1 to make this already-loaded model the default for new plans.
LM_STUDIO_AUTO_USE=0

# Optional. Fill only if your local LM Studio server requires authentication.
LM_STUDIO_API_KEY=

# Optional. Fill these to enable the corresponding Settings features.
OPENROUTER_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_API_KEY=
