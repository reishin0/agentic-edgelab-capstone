{
  "openapi": "3.1.0",
  "info": {
    "title": "EdgeLab synthetic research reports",
    "version": "1.0.0"
  },
  "servers": [{"url": "/v1"}],
  "security": [{"serviceBearer": []}],
  "paths": {
    "/runs": {
      "get": {
        "operationId": "listRuns",
        "summary": "List saved synthetic EdgeLab study reports available to the reader.",
        "responses": {
          "200": {
            "description": "Authorized study references",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StudyList"}}}
          }
        }
      }
    },
    "/runs/{study_id}": {
      "get": {
        "operationId": "getRunReport",
        "summary": "Read an approved synthetic report by its study ID, with recorded verdict, statistics, and evidence digests.",
        "parameters": [
          {
            "in": "path",
            "name": "study_id",
            "required": true,
            "schema": {"$ref": "#/components/schemas/StudyId"}
          }
        ],
        "responses": {
          "200": {
            "description": "Verified report projection",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StudyReport"}}}
          },
          "404": {"description": "Study unavailable"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceBearer": {"type": "http", "scheme": "bearer"}
    },
    "schemas": {
      "StudyId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
      "RunId": {"type": "string", "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"},
      "Sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "Verdict": {"type": "string", "enum": ["continue", "revise", "stop", "unresolved"]},
      "Date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
      "PValue": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
      "StudySummary": {
        "type": "object",
        "properties": {
          "study_id": {"$ref": "#/components/schemas/StudyId"},
          "run_id": {"$ref": "#/components/schemas/RunId"},
          "verdict": {"$ref": "#/components/schemas/Verdict"},
          "ledger_sha256": {"$ref": "#/components/schemas/Sha256"}
        },
        "required": ["study_id", "run_id", "verdict", "ledger_sha256"],
        "additionalProperties": false
      },
      "StudyList": {
        "type": "object",
        "properties": {
          "schema_version": {"type": "integer", "const": 1},
          "runs": {
            "type": "array",
            "maxItems": 2,
            "items": {"$ref": "#/components/schemas/StudySummary"}
          }
        },
        "required": ["schema_version", "runs"],
        "additionalProperties": false
      },
      "Window": {
        "type": "object",
        "properties": {
          "start": {"$ref": "#/components/schemas/Date"},
          "end": {"$ref": "#/components/schemas/Date"},
          "as_of": {"$ref": "#/components/schemas/Date"},
          "holdout_start": {"$ref": "#/components/schemas/Date"}
        },
        "required": ["start", "end", "as_of", "holdout_start"],
        "additionalProperties": false
      },
      "Diagnostics": {
        "type": "object",
        "properties": {
          "engle_granger_a_on_b_p": {"$ref": "#/components/schemas/PValue"},
          "engle_granger_b_on_a_p": {"$ref": "#/components/schemas/PValue"},
          "cusum_p": {"$ref": "#/components/schemas/PValue"},
          "ecm_loading": {"type": ["number", "null"]},
          "ou_half_life_observations": {"type": ["number", "null"]}
        },
        "required": ["engle_granger_a_on_b_p", "engle_granger_b_on_a_p", "cusum_p", "ecm_loading", "ou_half_life_observations"],
        "additionalProperties": false
      },
      "Evidence": {
        "type": "object",
        "properties": {
          "event_key": {"type": "string", "pattern": "^(?:(?:result|review):(?:diagnostics|engle_granger|stability)|verdict)$"},
          "sha256": {"$ref": "#/components/schemas/Sha256"},
          "critic_rule": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}
        },
        "required": ["event_key", "sha256", "critic_rule"],
        "additionalProperties": false
      },
      "StudyReport": {
        "type": "object",
        "properties": {
          "schema_version": {"type": "integer", "const": 1},
          "study_id": {"$ref": "#/components/schemas/StudyId"},
          "run_id": {"$ref": "#/components/schemas/RunId"},
          "verdict": {"$ref": "#/components/schemas/Verdict"},
          "ledger_sha256": {"$ref": "#/components/schemas/Sha256"},
          "scope": {"type": "string", "const": "synthetic in-sample"},
          "holdout": {"type": "string", "const": "locked and untested"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 320},
          "window": {"$ref": "#/components/schemas/Window"},
          "diagnostics": {"$ref": "#/components/schemas/Diagnostics"},
          "evidence": {"type": "array", "maxItems": 7, "items": {"$ref": "#/components/schemas/Evidence"}}
        },
        "required": ["schema_version", "study_id", "run_id", "verdict", "ledger_sha256", "scope", "holdout", "reason", "window", "diagnostics", "evidence"],
        "additionalProperties": false
      }
    }
  }
}
