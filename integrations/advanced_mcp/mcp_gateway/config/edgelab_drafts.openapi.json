{
  "openapi": "3.1.0",
  "info": {
    "title": "EdgeLab synthetic study drafts",
    "version": "1.0.0"
  },
  "servers": [{"url": "/v1"}],
  "security": [{"serviceBearer": []}],
  "paths": {
    "/drafts/preview": {
      "post": {
        "operationId": "previewDraft",
        "summary": "Normalize and preview a synthetic draft without saving it or accessing observations.",
        "requestBody": {"$ref": "#/components/requestBodies/Draft"},
        "responses": {
          "200": {
            "description": "Bound draft preview",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Preview"}}}
          }
        }
      }
    },
    "/drafts": {
      "post": {
        "operationId": "saveDraft",
        "x-edgelab-draft-receipt": true,
        "summary": "Save one draft with an exact preview digest and request ID after durable workflow approval.",
        "requestBody": {"$ref": "#/components/requestBodies/SaveRequest"},
        "responses": {
          "200": {"$ref": "#/components/responses/Saved"},
          "409": {"$ref": "#/components/responses/NotSaved"}
        }
      }
    },
    "/drafts/receipt": {
      "post": {
        "operationId": "getDraftReceipt",
        "x-edgelab-draft-receipt": true,
        "summary": "Read the canonical save receipt for the exact original request without creating a draft.",
        "requestBody": {"$ref": "#/components/requestBodies/SaveRequest"},
        "responses": {
          "200": {"$ref": "#/components/responses/Saved"},
          "404": {"description": "Receipt unavailable for this binding"},
          "409": {"description": "Request ID refers to different draft inputs"}
        }
      }
    },
    "/drafts/{request_id}/readiness": {
      "get": {
        "operationId": "checkDraftReadiness",
        "summary": "Check whether a saved draft is bound to the current synthetic planning inputs.",
        "parameters": [
          {"$ref": "#/components/parameters/RequestId"},
          {"$ref": "#/components/parameters/PreviewSha256"}
        ],
        "responses": {
          "200": {
            "description": "Draft readiness metadata",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Readiness"}}}
          },
          "404": {"description": "Draft unavailable for this binding"}
        }
      }
    },
    "/drafts/{request_id}/handoff": {
      "get": {
        "operationId": "getDraftHandoff",
        "summary": "Return the local EdgeLab planning arguments for researcher review.",
        "parameters": [
          {"$ref": "#/components/parameters/RequestId"},
          {"$ref": "#/components/parameters/PreviewSha256"}
        ],
        "responses": {
          "200": {
            "description": "Local planning handoff",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Handoff"}}}
          },
          "404": {"description": "Draft unavailable for this binding"},
          "409": {"description": "Draft binding is stale"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceBearer": {"type": "http", "scheme": "bearer"}
    },
    "parameters": {
      "RequestId": {
        "in": "path",
        "name": "request_id",
        "required": true,
        "schema": {"$ref": "#/components/schemas/RequestId"}
      },
      "PreviewSha256": {
        "in": "query",
        "name": "preview_sha256",
        "required": true,
        "schema": {"$ref": "#/components/schemas/Sha256"}
      }
    },
    "requestBodies": {
      "Draft": {
        "required": true,
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Draft"}}}
      },
      "SaveRequest": {
        "required": true,
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SaveRequest"}}}
      }
    },
    "responses": {
      "Saved": {
        "description": "Canonical receipt for a saved draft",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Receipt"}}}
      },
      "NotSaved": {
        "description": "The draft store refused this exact request without applying a new save",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NotSaved"}}}
      }
    },
    "schemas": {
      "Version": {"type": "integer", "const": 1},
      "Ready": {"type": "string", "const": "ready_for_review"},
      "Case": {"type": "string", "enum": ["shared-trend", "spread-level-shift"]},
      "Sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "RequestId": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "Draft": {
        "type": "object",
        "properties": {
          "template_id": {"type": "string", "const": "cointegration-fixture"},
          "case": {"$ref": "#/components/schemas/Case"},
          "hypothesis": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "required": ["template_id", "case", "hypothesis"],
        "additionalProperties": false
      },
      "Binding": {
        "type": "object",
        "properties": {
          "release_sha256": {"$ref": "#/components/schemas/Sha256"},
          "corpus_sha256": {"$ref": "#/components/schemas/Sha256"},
          "fixture_sha256": {"$ref": "#/components/schemas/Sha256"}
        },
        "required": ["release_sha256", "corpus_sha256", "fixture_sha256"],
        "additionalProperties": false
      },
      "Preview": {
        "type": "object",
        "properties": {
          "schema_version": {"$ref": "#/components/schemas/Version"},
          "status": {"$ref": "#/components/schemas/Ready"},
          "scope": {"type": "string", "const": "synthetic in-sample"},
          "draft": {"$ref": "#/components/schemas/Draft"},
          "preview_sha256": {"$ref": "#/components/schemas/Sha256"},
          "binding": {"$ref": "#/components/schemas/Binding"},
          "method_gates": {
            "type": "array",
            "const": ["ADF/KPSS integration diagnostics", "Bidirectional Engle-Granger", "CUSUM stability"]
          },
          "missing_requirements": {
            "type": "array",
            "const": ["EdgeLab plan", "Exact run and protocol approval"]
          }
        },
        "required": ["schema_version", "status", "scope", "draft", "preview_sha256", "binding", "method_gates", "missing_requirements"],
        "additionalProperties": false
      },
      "SaveRequest": {
        "type": "object",
        "properties": {
          "request_id": {"$ref": "#/components/schemas/RequestId"},
          "preview_sha256": {"$ref": "#/components/schemas/Sha256"},
          "draft": {"$ref": "#/components/schemas/Draft"}
        },
        "required": ["request_id", "preview_sha256", "draft"],
        "additionalProperties": false
      },
      "Receipt": {
        "type": "object",
        "properties": {
          "schema_version": {"$ref": "#/components/schemas/Version"},
          "status": {"type": "string", "const": "saved"},
          "request_id": {"$ref": "#/components/schemas/RequestId"},
          "preview_sha256": {"$ref": "#/components/schemas/Sha256"},
          "receipt_sha256": {"$ref": "#/components/schemas/Sha256"}
        },
        "required": ["schema_version", "status", "request_id", "preview_sha256", "receipt_sha256"],
        "additionalProperties": false
      },
      "NotSaved": {
        "type": "object",
        "properties": {
          "error": {"type": "string", "minLength": 1, "maxLength": 160},
          "status": {"type": "string", "const": "not_saved"},
          "request_id": {"$ref": "#/components/schemas/RequestId"},
          "preview_sha256": {"$ref": "#/components/schemas/Sha256"}
        },
        "required": ["error", "status", "request_id", "preview_sha256"],
        "additionalProperties": false
      },
      "Readiness": {
        "type": "object",
        "properties": {
          "schema_version": {"$ref": "#/components/schemas/Version"},
          "status": {"type": "string", "enum": ["ready_for_review", "stale"]},
          "request_id": {"$ref": "#/components/schemas/RequestId"},
          "preview_sha256": {"$ref": "#/components/schemas/Sha256"}
        },
        "required": ["schema_version", "status", "request_id", "preview_sha256"],
        "additionalProperties": false
      },
      "Handoff": {
        "type": "object",
        "properties": {
          "schema_version": {"$ref": "#/components/schemas/Version"},
          "status": {"$ref": "#/components/schemas/Ready"},
          "request_id": {"$ref": "#/components/schemas/RequestId"},
          "preview_sha256": {"$ref": "#/components/schemas/Sha256"},
          "argv": {
            "type": "array",
            "minItems": 7,
            "maxItems": 7,
            "prefixItems": [
              {"const": "python"},
              {"const": "-B"},
              {"const": "-m"},
              {"const": "edgelab.capstone"},
              {"const": "plan"},
              {"const": "--case"},
              {"$ref": "#/components/schemas/Case"}
            ]
          }
        },
        "required": ["schema_version", "status", "request_id", "preview_sha256", "argv"],
        "additionalProperties": false
      }
    }
  }
}
